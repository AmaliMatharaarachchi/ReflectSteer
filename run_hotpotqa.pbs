#!/bin/bash
#PBS -N hotpotqa_reflexion
#PBS -P qw14
#PBS -q gpuvolta
#PBS -l walltime=02:00:00
#PBS -l mem=64GB,ncpus=12,ngpus=1,jobfs=2GB
#PBS -l storage=gdata/jq77+scratch/jq77+scratch/qw14
#PBS -l wd
#PBS -j oe

set -eo pipefail
module load pytorch/2.12.0
export PYTHONNOUSERSITE=1
source "${QWEN_VENV:-/scratch/qw14/aa1215/ReflectSteer/venv-nci}/bin/activate"
PYTHON_SITE=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
export PYTHONPATH="$PYTHON_SITE${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME=/scratch/qw14/aa1215/ReflectSteer/hf-cache
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export TMPDIR="${PBS_JOBFS:-/scratch/qw14/aa1215/ReflectSteer/tmp}"
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"
mkdir -p "$TMPDIR" "$HF_HOME"

# Submit from the ReflectSteer checkout; paths mirror the AgentRL environment.
cd "${PBS_O_WORKDIR:?Submit this script from the ReflectSteer directory}"
mkdir -p outs
export TIKTOKEN_CACHE_DIR="$PWD/data/tiktoken"
python -c 'from original_hotpotqa import upstream; upstream(); import torch; from transformers import AutoTokenizer, AutoModelForCausalLM; assert torch.cuda.is_available(), "CUDA unavailable"; print(torch.cuda.get_device_name(0), flush=True)'
python run_original_hotpotqa.py \
  --model-dir "${QWEN_MODEL_DIR:-/scratch/qw14/aa1215/qwen/model}" \
  --agent "${HOTPOT_AGENT:-cot-context}" --strategy "${HOTPOT_STRATEGY:-reflexion}" \
  --device cuda --limit "${HOTPOT_LIMIT:-100}" --offset "${HOTPOT_OFFSET:-0}" \
  --trials "${HOTPOT_TRIALS:-5}" --max-steps 6 --max-input-tokens 16384 \
  --output "$PWD/outs/hotpotqa.${PBS_JOBID}.jsonl"
