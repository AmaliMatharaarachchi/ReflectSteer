#!/bin/bash
#PBS -N wiki_worker
#PBS -P qw14
#PBS -q copyq
#PBS -l walltime=03:00:00
#PBS -l mem=4GB,ncpus=1
#PBS -l storage=scratch/qw14
#PBS -l wd
#PBS -j oe

set -Eeo pipefail
cd "${REFLECTSTEER_REPO:-/home/572/aa1215/workspace/repos/ReflectSteer}"
: "${WIKI_RELAY_DIR:?Set WIKI_RELAY_DIR to a shared scratch directory}"
mkdir -p outs
exec > >(tee -a "outs/wiki_worker.${PBS_JOBID}.log") 2>&1
module load pytorch/2.12.0
export PYTHONNOUSERSITE=1
source "${QWEN_VENV:-/scratch/qw14/aa1215/ReflectSteer/venv-nci}/bin/activate"
PYTHON_SITE=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
export PYTHONPATH="$PYTHON_SITE${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
python wiki_relay.py --directory "$WIKI_RELAY_DIR" --hours 2.9
